<button class="drink-switch" type="button" aria-label="Matcha. Switch to Diet Coke" title="Switch my drink">
 <span class="drink-art">
  <img class="matcha" src="/assets/arrange-desk/matcha-cup.png" alt="" loading="lazy" draggable="false"/>
  <img class="coke" src="/assets/arrange-desk/diet-coke.webp" alt="" loading="lazy" draggable="false" hidden/>
  <img class="coffee" src="/assets/arrange-desk/coffee-saucer.webp" alt="" loading="lazy" draggable="false" hidden/>
 </span>
</button>
<script>
import { deskTapSound } from '../scripts/desk-sound';
 document.querySelectorAll<HTMLButtonElement>('.drink-switch').forEach(button=>{
  const images=Array.from(button.querySelectorAll<HTMLImageElement>('img'));
  const names=['Matcha','Diet Coke','Black coffee'];
  let index=0,busy=false;
  button.addEventListener('click',async()=>{
   if(busy)return;
   busy=true;
   deskTapSound('drink');
   const next=(index+1)%images.length;
   try {
    images[next].loading='eager';
    await images[next].decode();
    images[index].hidden=true;images[next].hidden=false;index=next;
    button.setAttribute('aria-label',`${names[index]}. Switch to ${names[(index+1)%names.length]}`);
   }catch{}finally{busy=false;}
  });
 });
</script>
<style>
.drink-switch{display:block;position:relative;width:100%;height:100%;min-width:44px;min-height:44px;padding:0;border:0;background:none;cursor:pointer;touch-action:manipulation;pointer-events:auto}
.drink-switch:focus-visible{outline:2px solid #9d7abb;outline-offset:5px;border-radius:12px}
.drink-art{display:block;position:absolute;inset:0;transform-origin:50% 80%}
.drink-art img{position:absolute;max-width:none;pointer-events:none;object-fit:contain}
.drink-art img[hidden]{display:none}
.matcha{width:112.2%;height:137.7%;left:-9.1%;top:-18.8%;clip-path:inset(13.65% 2.77% 13.72% 8.11%)}
.coke{width:100%;height:145%;left:-6%;bottom:0}
.coffee{width:125%;height:125%;left:-15%;bottom:-7%}
</style>
