---
import home from '../data/home.json';
import mobileCovers from '../data/mobile-covers.json';
const mobile=(src:string)=>(mobileCovers as Record<string,{src:string,width:number}[]>)[src];
const mobileSet=(src:string)=>mobile(src)?.map(x=>`${x.src} ${x.width}w`).join(', ');
import BloomReveal from './BloomReveal.astro';
import AboutDesk from './AnimatedAboutDesk.astro';
import BloomPunchFooter from './BloomPunchFooter.astro';
import BloomLivingFooter from './BloomLivingFooter.astro';
import BloomTestimonials from './BloomTestimonials.astro';
import BloomMoreProjects from './BloomMoreProjects.astro';
const { livingFooter = false } = Astro.props;
import media from '../data/featured-media.json';
const covers = media as Record<string, { poster: string; src: string }>;
const shapeshifter=home.more.find(project=>project.href==='/shapeshifter')!;
const projectOrder=['/pitch-protocol','/venture-os','/turboml','/shapeshifter','/gfvc','/docus'];
const featured=[...home.featured,{...shapeshifter,media:[shapeshifter.media[0],shapeshifter.media[1],shapeshifter.media[0]]}].filter(project=>project.href!=='/ether').sort((a,b)=>projectOrder.indexOf(a.href)-projectOrder.indexOf(b.href));
const originalCover=(project:typeof home.featured[number])=>project.href==='/gfvc'?'/assets/growth-factory-intro-1080p.mp4':project.media[2].src.replace('.mov','.mp4');
---
<section class="featured" id="work" aria-labelledby="featured-title">
 <div class="scroll-runway">
  <div class="works-stage">
   <div class="section-heading"><h2 id="featured-title">Selected Works</h2></div>
   <div class="works-window">
    <div class="works-lane">
     {featured.map((project) => <a class="project" href={project.href}>
      <div class="project-caption"><h3><span class="company-logo" aria-hidden="true">{project.href === '/shapeshifter' ? <span class="shapeshifter-logo" /> : project.href === '/pitch-protocol' ? <svg viewBox="238 210 780 800"><image href={project.media[0].src} width="1254" height="1254" /></svg> : <img src={project.media[0].src} alt="" width="32" height="32" loading="lazy" />}</span>{project.title}</h3><p>{project.description}</p></div>
      <div class="cover">{originalCover(project).endsWith('.mp4') ? <video data-featured-video data-desktop-src={originalCover(project)} data-mobile-src={covers[project.href].src} poster={mobile(covers[project.href].poster)?.at(-1)?.src || covers[project.href].poster} data-desktop-poster={covers[project.href].poster} data-mobile-poster={mobile(covers[project.href].poster)?.at(-1)?.src} muted loop playsinline preload="none" aria-label={`${project.title} project preview`} /> : <picture><source media="(max-width:700px)" srcset={mobileSet(originalCover(project))} sizes="calc(100vw - 56px)"/><img src={originalCover(project)} alt={`${project.title} project cover`} width={project.media[2].width} height={project.media[2].height} loading="lazy" /></picture>}</div>
     </a>)}
    </div>
   </div>
  </div>
 </div>
</section>
<BloomMoreProjects />
{livingFooter ? <BloomReveal /> : <><AboutDesk /><BloomTestimonials /></>}
{livingFooter ? <BloomLivingFooter /> : <BloomPunchFooter />}

<style>
.featured{max-width:var(--portfolio-max,1456px);margin:0 auto;padding:72px var(--portfolio-gutter,max(28px,5vw)) 0}
.works-stage{padding:16px 0 40px}
.section-heading{display:flex;align-items:center;justify-content:space-between;gap:24px;margin-bottom:32px}
h2{font-family:var(--serif);font-size:clamp(40px,4vw,58px);font-weight:400;line-height:1.1;margin:0;letter-spacing:-.025em}


.works-lane{display:grid;grid-template-columns:minmax(0,1fr);gap:72px;position:relative}
.project{display:block;min-width:0;color:inherit;text-decoration:none}
.cover{position:relative;overflow:hidden;border-radius:22px;background:#f8f5f1;aspect-ratio:5/3}
.cover picture{position:absolute;inset:0;display:block;width:100%;height:100%}.cover img{display:block;width:100%;height:100%;object-fit:cover}
.project-caption{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,1fr);align-items:center;gap:32px;padding:0 2px 20px}
.project-caption h3{display:flex;align-items:center;gap:12px;font-size:clamp(23px,2.1vw,30px);font-weight:500;line-height:1.2;letter-spacing:-.025em;margin:0}
.company-logo{display:flex;align-items:center;justify-content:center;width:32px;height:32px;flex:0 0 32px}
.company-logo img,.company-logo svg{display:block;width:100%;height:100%;object-fit:contain}
.project-caption p{font-size:14px;line-height:1.5;color:#77716c;margin:0;max-width:390px;justify-self:end}
@media(max-width:809.98px){.featured{padding-top:64px}.section-heading{margin-bottom:36px}.cover{border-radius:16px}.works-lane{gap:40px}.project-caption{gap:8px;padding:0 0 16px;grid-template-columns:1fr}.project-caption h3{font-size:22px;gap:10px}.company-logo{width:26px;height:26px;flex-basis:26px}.project-caption p{justify-self:start;max-width:none;font-size:13px}}

.section-heading{margin-bottom:56px}
.project-caption{grid-template-columns:auto minmax(0,1fr);gap:28px}
.project-caption h3{font-size:24px;font-weight:500;color:#3f3f41;letter-spacing:-.015em}
.project-caption p{font-size:14px;color:#929198;max-width:none;white-space:nowrap}
.company-logo{border-radius:10px;corner-shape:superellipse(1.6);overflow:hidden}
.company-logo img,.company-logo svg{border-radius:inherit;corner-shape:inherit}
.cover video{position:absolute;inset:0;display:block;width:100%;height:100%;object-fit:cover}
@media(max-width:1100px){.project-caption{grid-template-columns:1fr;gap:8px}.project-caption p{justify-self:start;white-space:normal}}
@media(max-width:809.98px){.section-heading{margin-bottom:48px}.project-caption h3{font-size:21px}.project-caption p{font-size:13px}}
.shapeshifter-logo{display:block;width:100%;height:100%;background-image:url('/assets/UyKgbnpjm7CH2xpyldWv55XuLw.png?v=5ec4d670e3');background-size:1244.445px 746.665px;background-position:-74.665px -67.555px}
@media(max-width:809.98px){.shapeshifter-logo{background-size:1011.111px 606.665px;background-position:-60.665px -54.889px}}
/* Fit the entire artwork in matching phone frames; never crop its sides. */
@media(max-width:700px){.cover{aspect-ratio:5/3}.cover img,.cover video{object-fit:contain}}
</style>
<script>
const reduced=matchMedia('(prefers-reduced-motion:reduce)');
const previews=Array.from(document.querySelectorAll<HTMLVideoElement>('[data-featured-video]'));
previews.forEach(video=>{video.poster=matchMedia('(max-width:700px)').matches?video.dataset.mobilePoster||video.dataset.desktopPoster!:video.dataset.desktopPoster!;});
const observer=new IntersectionObserver(entries=>entries.forEach(entry=>{
 const video=entry.target as HTMLVideoElement;
 if(entry.isIntersecting&&!reduced.matches&&!document.hidden){if(!video.getAttribute('src'))video.src=matchMedia('(max-width:700px)').matches?video.dataset.mobileSrc!:video.dataset.desktopSrc!;video.muted=true;void video.play().catch(()=>{});}else video.pause();
}),{threshold:.2});
previews.forEach(video=>observer.observe(video));
document.addEventListener('visibilitychange',()=>previews.forEach(video=>{if(document.hidden)video.pause();else{observer.unobserve(video);observer.observe(video);}}));
reduced.addEventListener('change',()=>previews.forEach(video=>{observer.unobserve(video);observer.observe(video);}));
</script>
