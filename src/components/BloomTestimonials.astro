---
import home from '../data/home.json';
const people=[...home.testimonials.slice(6),...home.testimonials.slice(0,6)];
---
<section class="testimonials" id="testimonials" aria-label="Testimonials" aria-roledescription="carousel">
 <div class="testimonial-stage">
 {people.map((person,i)=><figure class:list={['testimonial',{'is-active':i===0}]} aria-hidden={i!==0} role="group" aria-roledescription="slide" aria-label={`${i+1} of ${people.length}`}>
  <blockquote>“{person.quote}”</blockquote>
  <figcaption><img src={person.image} alt="" width="44" height="44" loading="lazy"/><div><strong>{person.name}</strong><span>{person.role}</span></div></figcaption>
 </figure>)}
 </div>
 <div class="testimonial-navigation">
 <div class="testimonial-dots" role="group" aria-label="Choose a testimonial">{people.map((person,i)=><button type="button" data-testimonial-dot={i} aria-label={`Show testimonial ${i+1} from ${person.name}`} aria-current={i===0?'true':'false'}><span></span></button>)}</div>
 <div class="controls"><button type="button" data-testimonial-prev aria-label="Previous testimonials"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 19-7-7 7-7M5 12h14"/></svg></button><button type="button" data-testimonial-next aria-label="Next testimonials"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 5 7 7-7 7M5 12h14"/></svg></button></div>
 </div>
</section>
<style>
.testimonials{position:relative;box-sizing:border-box;width:100%;max-width:var(--portfolio-max,1456px);padding:44px calc(var(--portfolio-gutter,max(28px,5vw)) + 66px) 48px;margin:24px auto 40px;text-align:center;background:#fff;color:#45404a}
.quote-mark{display:grid;place-items:center;width:32px;height:32px;margin:0 auto 24px;border-radius:50%;background:#f3f2f1;color:#777;font:350 34px/1 var(--serif);padding-top:8px;box-sizing:border-box}
.testimonial-stage{position:relative;display:grid;max-width:960px;margin:auto;overflow:hidden}
.testimonial{grid-area:1/1;align-self:stretch;width:100%;min-width:0;margin:0;display:flex;flex-direction:column;align-items:center;justify-content:center;visibility:hidden;pointer-events:none}
.testimonial.is-active{visibility:visible;pointer-events:auto}
blockquote{font:350 clamp(25px,2.5vw,34px)/1.3 var(--serif);letter-spacing:-.015em;color:#45404a;margin:0 0 24px;text-wrap:pretty}
figcaption{display:flex;align-items:center;justify-content:center;gap:10px;text-align:left}
figcaption img{width:38px;height:38px;border-radius:50%;object-fit:cover;object-position:center 30%}
figcaption div{display:flex;flex-direction:column;gap:3px}figcaption strong{font:500 13px/1.4 var(--sans);color:#45404a}figcaption span{font:400 12px/1.4 var(--sans);color:#89838a}
.controls{position:absolute;left:var(--portfolio-gutter,max(28px,5vw));right:var(--portfolio-gutter,max(28px,5vw));top:50%;display:flex;justify-content:space-between;pointer-events:none;transform:translateY(-50%)}.controls button{display:grid;place-items:center;width:42px;height:42px;border:1px solid #e7e7e7;border-radius:50%;background:white;color:#666;cursor:pointer;pointer-events:auto;transition:background .2s}.controls button:hover{background:#f5f4f2}.controls button:focus-visible{outline:2px solid #777;outline-offset:4px}
@media(max-width:650px){.testimonials{padding:32px 48px 34px;margin:16px auto 24px}.quote-mark{margin-bottom:20px}blockquote{font-size:24px;line-height:1.3;margin-bottom:20px}.controls{left:8px;right:8px}.controls button{width:42px;height:42px}figcaption span{font-size:11px}}
@media(prefers-reduced-motion:reduce){.testimonial-stage{transition:none}}
.testimonial-dots{display:flex;justify-content:center;gap:0;margin:16px auto 0}.testimonial-dots button{display:grid;place-items:center;width:16px;height:24px;padding:0;border:0;background:transparent;cursor:pointer}.testimonial-dots span{width:6px;height:6px;border:0;border-radius:50%;background:#d4d4d4;box-sizing:border-box}.testimonial-dots [aria-current=true] span{background:#fe522e;border-color:#fe522e}.testimonial-dots button:focus-visible{outline:2px solid #777;outline-offset:2px}
.testimonial-navigation{display:contents}
@media(max-width:650px){
 .testimonials{padding-inline:24px}
 .testimonial-navigation{display:grid;place-items:center;position:relative;width:224px;height:44px;margin:18px auto 0}
 .testimonial-dots{margin:0}
 .testimonial-navigation .controls{left:0;right:0;top:50%}
}
</style>
<script>
const section=document.querySelector<HTMLElement>('#testimonials')!;
const slides=[...section.querySelectorAll<HTMLElement>('.testimonial')];
const reduce=matchMedia('(prefers-reduced-motion:reduce)');
const stage=section.querySelector<HTMLElement>('.testimonial-stage')!;
const dots=[...section.querySelectorAll<HTMLButtonElement>('[data-testimonial-dot]')];
let index=0, timer=0, visible=false, moving=false;

const schedule=()=>{
 window.clearInterval(timer);
 if(visible&&!document.hidden){timer=window.setInterval(()=>show(index+1),3000);}
};
function show(next:number){
 if(moving||(next+slides.length)%slides.length===index)return;
 const direction=next>index?1:-1;
 const previous=slides[index];
 index=(next+slides.length)%slides.length;
 const incoming=slides[index];
 dots.forEach((dot,i)=>dot.setAttribute("aria-current",String(i===index)));
 previous.setAttribute('aria-hidden','true');incoming.setAttribute('aria-hidden','false');
 incoming.classList.add('is-active');
 if(reduce.matches){previous.classList.remove('is-active');return;}
 moving=true;
 const options={duration:480,easing:'cubic-bezier(.22,1,.36,1)'};
 const out=previous.animate([{transform:'translateX(0)',opacity:1},{transform:`translateX(${-direction*100}%)`,opacity:0}],options);
 incoming.animate([{transform:`translateX(${direction*100}%)`,opacity:0},{transform:'translateX(0)',opacity:1}],options);
 void out.finished.then(()=>{previous.classList.remove('is-active');moving=false;});
}
section.querySelector('[data-testimonial-prev]')!.addEventListener('click',()=>{show(index-1);schedule();});
section.querySelector('[data-testimonial-next]')!.addEventListener('click',()=>{show(index+1);schedule();});
dots.forEach((dot,i)=>dot.addEventListener('click',()=>{show(i);schedule();}));
document.addEventListener('visibilitychange',schedule);reduce.addEventListener('change',schedule);
let appeared=false;
new IntersectionObserver(([entry])=>{
 visible=entry.isIntersecting;
 if(visible&&!appeared){appeared=true;if(!reduce.matches)section.animate([{opacity:0},{opacity:1}],{duration:650,easing:'cubic-bezier(.22,1,.36,1)'});}
 schedule();
},{threshold:0}).observe(section);
window.addEventListener('pagehide',()=>clearInterval(timer));
</script>
