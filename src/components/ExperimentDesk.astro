---
import DeskBooks from './DeskBooks.astro';
import DeskDrink from './DeskDrink.astro';
import PersonalDeskLaptop from './PersonalDeskLaptop.astro';
---
<section class="about-desk" id="experiment-desk" aria-label="About Vansita">
 <div class="desk-scene">
  <img class="desk-surface" src="/assets/arrange-desk/desk-extended.webp" width="1077" height="418" alt="Wooden desk" loading="eager" draggable="false"/>
  <div class="desk-object lamp"><div class="object-art"><button class="lamp-switch" type="button" aria-label="Turn lamp on" aria-pressed="false"><span class="lamp-hint" aria-hidden="true"></span><span class="lamp-glow" aria-hidden="true"></span><span class="lamp-art"><img src="/assets/arrange-desk/cream-table-lamp-unlit.png" alt="Cream ceramic table lamp" loading="eager" draggable="false"/></span></button></div></div>
  <div class="desk-object laptop-object"><div class="object-art"><PersonalDeskLaptop experiment/></div></div>
  <div class="desk-object bottle"><div class="object-art"><img src="/assets/arrange-desk/gradient-tumbler.png" alt="Pink and blue tumbler" loading="eager" draggable="false"/></div></div>
  <div class="desk-object journal"><DeskBooks/></div>
  <div class="desk-object cup"><DeskDrink/></div>
  <img class="seated-girl" src="/assets/about-entry/seated-girl-wheeled.webp" alt="Girl seated at her laptop" fetchpriority="high"/>
 </div>
</section>

<style>
.about-desk{max-width:var(--portfolio-max,1456px);padding:64px var(--portfolio-gutter) 90px;margin:auto;scroll-margin-top:75px}
.desk-scene{position:relative;isolation:isolate;aspect-ratio:1000/590;max-width:1080px;margin:auto;overflow:hidden;container-type:inline-size}
.desk-surface{position:absolute;top:52%;left:3%;width:94%;height:auto;pointer-events:none;user-select:none}
.desk-object{position:absolute;user-select:none}.object-art{width:100%;height:100%;transform-origin:50% 85%}.object-art>img,.lamp-switch>img{width:100%;height:100%;object-fit:contain;pointer-events:none;filter:drop-shadow(2px 7px 4px #63452115)}
.lamp{left:13.764%;top:29.08%;width:10.472%;height:29.92%;z-index:2}.pens{left:28%;top:48%;width:6.8%;height:15.5%;z-index:3}.laptop-object{left:33.5%;top:23%;width:33%;height:50%;z-index:4}.bottle{left:81%;top:33.5%;width:8%;height:31.5%;z-index:5}.phone{left:70%;top:55%;width:6.5%;height:25%;z-index:6}.journal{left:5%;top:61%;width:17%;height:21%;z-index:6}.cup{left:79%;top:65%;width:10%;height:13.8%;z-index:7}
/* Frame the transparent cutouts around their visible silhouettes, so every base
   meets its contact shadow instead of the original image's empty padding. */
.pens .object-art,.bottle .object-art,.cup .object-art{position:relative;overflow:hidden}
.pens .object-art>img,.bottle .object-art>img,.cup .object-art>img{position:absolute;max-width:none;object-fit:fill;filter:none}
.pens .object-art>img{width:217%;height:165%;left:-66%;top:-49%}
.bottle .object-art>img{width:183.8%;height:105.4%;left:-54.1%;top:-1.5%}
.cup .object-art>img{width:112.2%;height:137.7%;left:-9.1%;top:-18.8%}
.lamp::before,.pens::before,.bottle::before,.cup::before{content:"";position:absolute;bottom:0;left:22%;width:56%;height:4%;border-radius:50%;background:#62421e40;filter:blur(3px)}
.pens::before,.bottle::before,.cup::before{bottom:-1.4%;height:5%;left:8%;width:84%;background:#55341638;filter:blur(3px)}
.cup::before{left:4%;width:72%;height:9%;bottom:-2%;filter:blur(4px)}
.lamp-switch{position:relative;display:block;width:100%;height:100%;padding:0;border:0;background:none;cursor:pointer}.lamp-glow{position:absolute;inset:-20% -65% 0%;background:radial-gradient(ellipse at 50% 32%,#fff5bfe6 0%,#ffe48aa6 29%,#ffdc6940 51%,transparent 75%);filter:blur(12px);opacity:0;transition:opacity .35s;pointer-events:none}.lamp-art{position:absolute;inset:0;overflow:hidden;transition:filter .35s}.lamp-art img{position:absolute;width:183%;height:107%;max-width:none;left:-41.5%;top:-3.8%;pointer-events:none}.lamp-art::after{content:"";position:absolute;inset:2% 1% 48%;border-radius:5%;background:linear-gradient(180deg,#ffe5a1,#ffda79 60%,#ffe39a);opacity:0;transition:opacity .35s;pointer-events:none}.lamp-switch[aria-pressed=true] .lamp-art img{filter:brightness(1.08)}.lamp-switch[aria-pressed=true] .lamp-art::after{opacity:.32}.lamp-switch[aria-pressed=true] .lamp-glow{opacity:1}.lamp-switch:focus-visible,.personal-phone:focus-visible{outline:2px solid #ff522e;outline-offset:5px;border-radius:10px}
.personal-phone{display:block;width:100%;height:100%;border:2px solid #eb8141;background:#242129;border-radius:15px;padding:2px;box-shadow:0 5px 0 #b45129,3px 10px 10px #362d3230;transform:perspective(700px) rotateX(58deg) rotateZ(0deg);cursor:pointer;transform-style:preserve-3d}.phone-screen{position:relative;display:block;height:100%;overflow:hidden;border-radius:11px;background:#181720;color:#ede6f6}.phone-island{position:absolute;left:30%;top:4px;width:40%;height:7px;border-radius:10px;background:#0c0c10;z-index:3}.phone-date{position:relative;display:block;font-size:4px;margin-top:23px;z-index:2;opacity:.3}.phone-clock{position:relative;display:block;font-size:19px;font-weight:500;letter-spacing:-1px;z-index:2;opacity:.3}.phone-wallpaper{position:absolute;inset:0;background:radial-gradient(ellipse at 20% 95%,#e897a8,transparent 63%),radial-gradient(ellipse at 110% 30%,#b7a6eb,#50416c 90%);opacity:0;transition:opacity .3s}.personal-phone[aria-pressed=true] .phone-wallpaper,.personal-phone[aria-pressed=true] .phone-date,.personal-phone[aria-pressed=true] .phone-clock{opacity:1}.phone-bottom{position:absolute;bottom:5px;left:30%;width:40%;height:2px;border-radius:3px;background:#d8cedd;z-index:3}
.journal .object-art>img{object-fit:contain;filter:none;transform:scaleY(1.28);transform-origin:50% 78%}
.about-copy{display:grid;grid-template-columns:1fr 1.7fr;gap:72px;margin:48px 0 0}.about-copy h2{font:350 clamp(40px,4vw,58px)/1.1 var(--serif);color:#353539;margin:0;letter-spacing:-.025em}.about-copy p{font-size:16px;line-height:1.7;margin:0 0 18px;color:#74706b}

@media(max-width:700px){.about-desk{padding-top:40px;padding-bottom:48px}.desk-scene{margin-inline:-12px;aspect-ratio:1000/590}.about-copy{grid-template-columns:1fr;gap:24px;margin-top:32px}.about-copy p{font-size:14px;line-height:1.7}.personal-phone{border-width:1px;border-radius:6px;padding:1px}.phone-screen{border-radius:4px}.phone-island{top:2px;height:3px}.phone-date{display:none}.phone-clock{font-size:8px;margin-top:9px;letter-spacing:-.4px}}
@media(prefers-reduced-motion:reduce){.object-art{animation:none}.phone-wallpaper,.lamp-glow,.lamp-art,.lamp-art::after{transition:none}}
</style>

<style>
.about-desk{width:100%;max-width:none;padding:0;margin:0}.desk-scene{max-width:none;overflow:visible;margin:0;aspect-ratio:1000/590}.laptop-object{top:50%;left:33.5%;width:33%;height:50%}.seated-girl{position:absolute;left:30%;top:57%;width:40%;height:auto;z-index:8;pointer-events:none}.lamp-switch{pointer-events:none}
@media(max-width:700px){.about-desk{padding:0}.desk-scene{margin:0}}
</style>
<style is:global>
#experiment-desk{padding:0;margin:0;max-width:none;width:100%}
#experiment-desk .desk-scene{overflow:visible;max-width:none;margin:0}
#experiment-desk .personal-laptop{pointer-events:none}
#experiment-desk .laptop,#experiment-desk .lid{transition:none}
#experiment-desk .wallpaper,#experiment-desk .dock,#experiment-desk .screen::after{display:none}
#experiment-desk .screen{background:#fff}
#experiment-desk .laptop-object{top:26%;left:35.15%;width:29.7%;height:45%}
#experiment-desk .seated-girl{top:55%;left:30%;width:40%}
#experiment-desk .desk-surface{left:3%;width:94%;height:auto}
</style>

<style>
.lamp-hint{position:absolute;z-index:3;left:32%;top:14%;width:36%;height:22%;border-radius:50%;background:radial-gradient(ellipse,#fff7ceaa,#ffe79d44 42%,transparent 72%);pointer-events:none;opacity:.55}
.lamp-switch[data-discovered] .lamp-hint{display:none}
.lamp-hint::before,.lamp-hint::after{content:"";position:absolute;left:50%;top:50%;width:115%;aspect-ratio:1;border:1px solid #d6b57b;border-radius:50%;animation:lamp-invitation 2s ease-out infinite}
.lamp-hint::after{animation-delay:-.4s}
@keyframes lamp-invitation{0%{opacity:0;transform:translate(-50%,-50%) scale(.8)}18%{opacity:.5}80%,100%{opacity:0;transform:translate(-50%,-50%) scale(1.8)}}
@media(prefers-reduced-motion:reduce){.lamp-hint::before,.lamp-hint::after{animation:none;display:none}}
</style>
