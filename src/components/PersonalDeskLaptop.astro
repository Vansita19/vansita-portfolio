.trackpad{background:linear-gradient(135deg,#d7c8e5,#bdabce);border-color:#9e86af;box-shadow:inset 0 1px 2px #79608d30,0 1px #f0e2fc99}
.screen::after{content:"";position:absolute;inset:0;z-index:4;pointer-events:none;background:linear-gradient(118deg,#fff2,transparent 35%,transparent 68%,#ffffff08);box-shadow:inset 0 0 4px #0006;border-radius:inherit}
</style>