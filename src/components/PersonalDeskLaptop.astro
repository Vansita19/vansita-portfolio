.chassis-left{left:0}.chassis-right{left:100%;background:linear-gradient(90deg,#d8c6e8,#907d9e)}
.chassis-left i{position:absolute;top:70px;left:2px;width:4px;height:25px;border-radius:3px;background:#463a50;box-shadow:inset 1px 0 #221b2a,1px 0 #decaed}.chassis-left i+i{top:108px}
.hinge-bar{position:absolute;left:55px;right:55px;top:0;height:12px;transform:translateZ(3px);border-radius:8px;background:linear-gradient(#4c405a,#a48db7 45%,#655173);box-shadow:0 5px 9px #49344c30}
.laptop-contact{position:absolute;inset:5px 1px -2px;border-radius:20px;transform:translateZ(-11px);background:#44304c28;box-shadow:0 5px 5px #32213933,0 13px 22px #3d2c402b;pointer-events:none}
