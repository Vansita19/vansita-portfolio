const { experiment = false } = Astro.props;
const rows=[['esc','1','2','3','4','5','6','7','8','9','0','⌫'],['⇥','Q','W','E','R','T','Y','U','I','O','P'],['⇪','A','S','D','F','G','H','J','K','L','↵'],['⇧','Z','X','C','V','B','N','M',',','.','⇧'],['fn','⌃','⌥','⌘','space','⌘','⌥','◀','▲','▶']];
---
<div class:list={["personal-laptop", {open: experiment}]} data-experiment={experiment ? "true" : undefined} tabindex={experiment ? undefined : "0"} role="group" aria-label="Purple laptop. Hover or focus to open; tap to toggle."><div class="scene"><div class="laptop" >
<div class="laptop-contact" aria-hidden="true"></div>
<div class="base"><div class="base-bottom" aria-hidden="true"></div><div class="chassis-front" aria-hidden="true"><i></i></div><div class="chassis-side chassis-left" aria-hidden="true"><i></i><i></i></div><div class="chassis-side chassis-right" aria-hidden="true"></div><div class="hinge-bar" aria-hidden="true"></div><div class="keyboard">{rows.map(row=><div class="key-row">{row.map(key=><span class:list={['key',{'space':key==='space'}]}>{key==='space'?'':key}</span>)}</div>)}</div><div class="trackpad"></div><div class="speaker left"></div><div class="speaker right"></div><div class="notch"></div></div>
<div class="lid"><div class="lid-edge lid-edge-front" aria-hidden="true"></div><div class="lid-edge lid-edge-left" aria-hidden="true"></div><div class="lid-edge lid-edge-right" aria-hidden="true"></div><div class="lid-outside"><svg class="metal-mark" viewBox="0 0 24 24" role="img" aria-label="Apple"><path fill="currentColor" d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.76 3.08.82 1.18-.24 2.31-.95 3.57-.86 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 3-2.54 4.09l.01-.01ZM12.03 7.25C11.88 5.02 13.69 3.18 15.77 3c.29 2.58-2.34 4.5-3.74 4.25Z"/></svg><div class="decal small">always cooking<br/>something cool</div></div>
<div class="lid-inside"><div class="camera"></div><div class="screen"><div class="wallpaper"><div class="screen-content"><section data-view="desk"><div class="clock">00:00</div><p class="location"><span class="laptop-date"></span></p></section><section class="app-window" data-view="figma" hidden><div class="window-title"><i></i><i></i><i></i><span>Figma</span></div><h2>A little space to design.</h2><div class="figma-canvas"><div></div><div></div><div></div></div></section><section class="app-window" data-view="codex" hidden><div class="window-title"><i></i><i></i><i></i><span>Codex</span></div><h2>What shall we build?</h2><p class="app-prompt">A little corner of my internet.</p><div class="prompt-line">Let’s make it real. <span>↵</span></div></section><section class="app-window" data-view="claude" hidden><div class="window-title"><i></i><i></i><i></i><span>Claude</span></div><h2>A little room to think.</h2><p class="app-prompt">Ideas, questions, and a fresh perspective.</p><div class="prompt-line">What are we exploring? <span>↵</span></div></section><section class="app-window" data-view="cursor" hidden><div class="window-title"><i></i><i></i><i></i><span>Cursor</span></div><div class="editor-note"><span>// a work in progress</span><br/>const workspace = &#123;<br/>&nbsp; curiosity: true,<br/>&nbsp; possibilities: 'endless'<br/>&#125;;</div></section><section class="app-window" data-view="framer" hidden><div class="window-title"><i></i><i></i><i></i><span>Framer</span></div><div class="framer-canvas"><small>ON MY DESK</small><h2>A familiar little workspace.</h2><div>Made with a little curiosity. ↗</div></div></section><section class="app-window" data-view="notes" hidden><div class="window-title"><i></i><i></i><i></i><span>Notes</span></div><textarea aria-label="My scratchpad" placeholder="A thought to come back to…" spellcheck="false"></textarea></section></div></div><nav class="dock" aria-label="My MacBook dock"><button class="app-figma" data-tab="figma" aria-label="Open Figma" aria-pressed="false"><img src="/assets/laptop-dock/figma.png" alt="" width="40" height="40"/><span>Figma</span></button><button class="app-codex" data-tab="codex" aria-label="Open Codex" aria-pressed="false"><img src="/assets/laptop-dock/codex.png" alt="" width="40" height="40"/><span>Codex</span></button><button class="app-claude" data-tab="claude" aria-label="Open Claude" aria-pressed="false"><img src="/assets/laptop-dock/claude.png" alt="" width="40" height="40"/><span>Claude</span></button><button class="app-cursor" data-tab="cursor" aria-label="Open Cursor" aria-pressed="false"><img src="/assets/laptop-dock/cursor.png" alt="" width="40" height="40"/><span>Cursor</span></button><button class="app-framer" data-tab="framer" aria-label="Open Framer" aria-pressed="false"><img src="/assets/laptop-dock/framer.png" alt="" width="40" height="40"/><span>Framer</span></button><button class="app-notes" data-tab="notes" aria-label="Open Notes" aria-pressed="false"><img src="/assets/laptop-dock/notes.png" alt="" width="40" height="40"/><span>Notes</span></button></nav></div></div></div>
</div></div>
</div>
<script>
document.querySelectorAll<HTMLElement>('.personal-laptop').forEach(root=>{
if(root && !root.dataset.experiment){
function setOpen(open:boolean){root.classList.toggle('open',open);root.querySelector<HTMLElement>('.lid-inside')!.inert=!open;}
setOpen(false);
root.addEventListener('pointerenter',e=>{if(e.pointerType==='mouse')setOpen(true);});
root.addEventListener('pointerleave',e=>{if(e.pointerType==='mouse'&&!root.matches(':focus-visible')&&!root.querySelector(':focus-visible'))setOpen(false);});
root.addEventListener('focusin',e=>{if(e.target!==root||root.matches(':focus-visible'))setOpen(true);});
root.addEventListener('focusout',e=>{if(!root.contains(e.relatedTarget as Node)&&!root.matches(':hover'))setOpen(false);});
root.addEventListener('click',e=>{if((e.target as HTMLElement).closest('button,textarea'))return;setOpen(!root.classList.contains('open'));});
root.addEventListener('keydown',e=>{if(e.target!==root)return;if(e.key==='Enter'||e.key===' '){e.preventDefault();setOpen(!root.classList.contains('open'));}if(e.key==='Escape')setOpen(false);});
new ResizeObserver(()=>root.style.setProperty('--laptop-width',String(root.clientWidth))).observe(root);
root.querySelectorAll<HTMLButtonElement>('[data-tab]').forEach(button=>button.addEventListener('click',()=>{setOpen(true);const selected=button.getAttribute('aria-pressed')==='true'?'desk':button.dataset.tab;root.querySelectorAll('[data-tab]').forEach(b=>b.setAttribute('aria-pressed',String((b as HTMLElement).dataset.tab===selected)));root.querySelectorAll<HTMLElement>('[data-view]').forEach(view=>view.hidden=view.dataset.view!==selected);}));
function clock(){const now=new Date();const time=now.toLocaleTimeString('en-GB',{hour:'2-digit',minute:'2-digit'});root.querySelector('.clock')!.textContent=time;root.querySelector('.laptop-date')!.textContent=now.toLocaleDateString('en-GB',{weekday:'short',day:'numeric',month:'short'});}
clock();setInterval(clock,60000);
}
});
</script>
<style>.scene{position:absolute;width:620px;height:380px;left:50%;top:260px;transform:translateX(-50%) scale(.85);transform-origin:top center;perspective:1600px}.laptop{position:relative;width:620px;height:380px;transform-style:preserve-3d;transform:rotateX(58deg) rotateZ(0deg);transition:transform 1.2s cubic-bezier(.22,1,.36,1)}.open .laptop{transform:rotateX(58deg) rotateZ(0deg)}.base{position:absolute;inset:0;background:linear-gradient(120deg,#d5c9e4,#b9abc9 60%,#a99ab8);border-radius:18px;box-shadow:0 8px 0 #9c8fab,0 10px 0 #756a83;transform:translateZ(0);border:1px solid #e5dced}.lid{position:absolute;inset:0;transform-style:preserve-3d;transform-origin:center top;transform:translateZ(7px) rotateX(0deg);transition:transform 1.25s cubic-bezier(.22,1,.36,1)}.open .lid{transform:translateZ(7px) rotateX(112deg)}.lid-outside,.lid-inside{position:absolute;inset:0;backface-visibility:hidden;border-radius:18px}.lid-outside{background:linear-gradient(125deg,#d7cbe6,#c2b0d7 65%,#aa99bf);border:2px solid #ded4e8;box-shadow:0 4px 0 #a491b7,0 7px 0 #908099;overflow:hidden}.metal-mark{position:absolute;left:46%;top:38%;font-size:64px;font-weight:600;color:#867197;letter-spacing:-.09em}.decal{position:absolute;box-shadow:0 2px 2px #0002;border:4px solid #fffaf0;color:#f9f4e9}.small{left:45px;bottom:42px;background:#342547;font-size:17px;line-height:1.15;font-weight:600;padding:9px 17px;border-radius:30px;transform:rotate(8deg)}.lid-inside{background:#27242a;padding:13px 13px 22px;transform:rotateX(180deg) translateZ(1px);border:3px solid #a79aaf;box-shadow:inset 0 0 0 1px #514953}.screen{position:relative;height:100%;border-radius:7px;background:#f78750;overflow:hidden;color:#442c24}.camera{position:absolute;top:5px;left:50%;width:4px;height:4px;border-radius:50%;background:#101014}.bezel-name{position:absolute;bottom:6px;font-size:6px;letter-spacing:.18em;color:#999;left:0;right:0;text-align:center}.menubar{height:23px;display:flex;gap:20px;align-items:center;padding:0 13px;background:#fff8;font-size:8px;position:relative;z-index:2}.menubar time{margin-left:auto}.wallpaper{position:absolute;inset:0;overflow:hidden;background:#063b2f url('/assets/arrange-desk/laptop-wallpaper.jpg') center/cover no-repeat}.sun{position:absolute;right:35px;top:20px;width:220px;height:220px;border-radius:50%;background:#ffdc93}.wave{position:absolute;right:-80px;bottom:-175px;width:520px;height:370px;border-radius:50%;background:#ec602f;transform:rotate(-30deg)}.screen-content{position:relative;padding:24px 30px;z-index:1}.eyebrow{font-size:8px;letter-spacing:.13em;margin:0 0 12px}.clock{font-size:70px;font-weight:400;letter-spacing:-.07em;line-height:1.1}.location{font-size:10px;margin:7px 0 0}.desktop-note{position:absolute;right:26px;top:94px;width:170px;padding:16px;background:#fff4d9;box-shadow:1px 4px 8px #6b35151a;transform:rotate(5deg);font-size:12px;line-height:1.4;border-radius:2px}.desktop-note>span{display:block;margin-bottom:15px;font-size:22px}.dock{position:absolute;z-index:3;left:50%;bottom:12px;transform:translateX(-50%);display:flex;gap:8px;padding:6px;background:#fff8;border:1px solid #fffa;border-radius:14px;backdrop-filter:blur(12px)}.dock button{position:relative;width:34px;height:34px;border:0;border-radius:9px;background:#fff8;font-size:22px;color:#663e28;transition:transform .2s}.dock button[aria-pressed=true]{background:#fffc;box-shadow:0 2px 3px #0001}.dock button:hover{transform:translateY(-3px)}.dock button span{position:absolute;bottom:43px;left:50%;transform:translateX(-50%);font-size:9px;background:#30271e;color:#fff;padding:5px 8px;border-radius:5px;white-space:nowrap;opacity:0}.dock button:hover span,.dock button:focus-visible span{opacity:1}section[hidden]{display:none}.screen-content h2{font-size:25px;line-height:1.13;font-weight:500;letter-spacing:-.035em;margin:0 0 18px}.tool-list{display:flex;gap:12px}.tool-list>span{font-size:11px;background:#fff9;border:1px solid #fff9;padding:12px;width:140px;border-radius:10px}.tool-list i{display:inline-grid;place-items:center;width:24px;height:24px;background:#40312d;color:white;border-radius:6px;margin-right:7px;font-style:normal}.tool-list small{display:block;font-size:8px;margin-top:9px;opacity:.65}.off-grid{display:flex;gap:10px}.off-grid span{background:#fff9;padding:12px;border-radius:10px;font-size:22px;width:145px}.off-grid b{display:block;font-size:9px;margin-top:9px;font-weight:500}.keyboard{position:absolute;top:30px;left:55px;right:55px;background:#655970;border-radius:9px;padding:6px;display:flex;flex-direction:column;gap:5px}.key-row{display:flex;gap:5px}.key{height:31px;flex:1;background:#302c37;border:1px solid #514b5a;box-shadow:0 2px 0 #211d27;border-radius:4px;color:#b8b2c0;display:grid;place-items:center;font-size:9px}.key.space{flex:5}.trackpad{position:absolute;bottom:25px;left:200px;width:220px;height:108px;border:1px solid #9b8aa9;border-radius:9px;background:#c5b7d2}.speaker{position:absolute;top:40px;width:23px;height:178px;background-image:radial-gradient(#84768e .6px,transparent .8px);background-size:3px 3px}.speaker.left{left:19px}.speaker.right{right:19px}.notch{position:absolute;bottom:0;left:270px;width:80px;height:4px;border-radius:10px;background:#887995}.ground-shadow{position:absolute;left:50%;top:290px;width:590px;height:220px;transform:translateX(-50%) rotate(-12deg);border-radius:50%;background:#65506b3a;filter:blur(35px);transition:transform 1s,opacity 1s}.open .ground-shadow{transform:translateX(-50%) scale(.95,.7);opacity:.6}.laptop-toggle{position:absolute;bottom:0;left:50%;transform:translateX(-50%);background:#fff;border:1px solid #e0dad2;padding:12px 19px;border-radius:30px;font-size:12px;color:#605851;z-index:4}.laptop-toggle span{margin-left:16px}.caption{display:flex;justify-content:center;gap:30px;font-size:10px;color:#a0978f;padding:25px 20px 35px}.live i{display:inline-block;width:5px;height:5px;border-radius:50%;background:#96a582;margin-right:6px}button:focus-visible,a:focus-visible{outline:2px solid #ff522e;outline-offset:4px}@media(prefers-reduced-motion:reduce){*,*::before,*::after{transition:none!important}}

.metal-mark{width:65px;height:77px;left:calc(50% - 32px);top:calc(50% - 45px);color:#847092;filter:drop-shadow(0 1px 0 #ece0f570)}
.dock{gap:7px;padding:6px 8px;background:#ffffffa6;backdrop-filter:none}
.dock button{display:grid;place-items:center;width:35px;height:35px;background:#f6f3ee;color:#1b1b1b}
.dock button svg{width:25px;height:25px}.dock .app-figma svg{width:19px;height:27px}.dock .app-framer svg{width:21px}
.dock .app-cursor{background:#202020}.dock .app-codex{background:#eeeae2}.dock .app-notes{background:transparent}
.app-window{background:#fffaf4;border:1px solid #fff9;box-shadow:0 5px 14px #48241216;border-radius:9px;margin-top:-13px;height:213px;overflow:hidden}
.window-title{height:25px;display:flex;align-items:center;gap:4px;border-bottom:1px solid #eee5d9;padding:0 10px;font-size:9px}.window-title i{width:6px;height:6px;border-radius:50%;background:#ff6259}.window-title i:nth-child(2){background:#ffbf42}.window-title i:nth-child(3){background:#33c749}.window-title span{margin:auto;color:#797068;padding-right:25px}
.app-window h2{font-size:19px;margin:20px 20px 12px}.app-prompt{font-size:11px;margin:0 20px}.prompt-line{font-size:10px;padding:11px;margin:22px 20px;background:#f0ebe2;border-radius:7px}.prompt-line span{float:right}
.figma-canvas{display:flex;gap:15px;align-items:center;justify-content:center;padding:10px;background:#f1eee8;height:107px}.figma-canvas div{width:67px;height:76px;background:#c7b0e0;border-radius:4px}.figma-canvas div:nth-child(2){background:#f4a276;height:55px;border-radius:50%}.figma-canvas div:nth-child(3){background:#e4e7a6;transform:rotate(7deg)}
.editor-note{font:13px/1.7 monospace;padding:19px 24px;color:#55436d}.editor-note span{color:#99948b}
.framer-canvas{text-align:center;padding:17px 20px;background:#f4eafc;height:100%}.framer-canvas small{font-size:7px;letter-spacing:.12em}.framer-canvas h2{margin:16px auto;font:24px Georgia,serif;max-width:240px}.framer-canvas div{font-size:9px}
.app-window textarea{resize:none;background:transparent;border:0;outline:0;width:100%;height:175px;padding:18px;font:13px/1.6 Desk,sans-serif;color:#443a31}
.stage{margin-bottom:30px}

/* Use the actual macOS app artwork, including its own rounded tile and padding. */
.dock{gap:4px;padding:4px 6px}
.dock button,.dock button[aria-pressed=true],.dock .app-cursor,.dock .app-codex,.dock .app-notes{width:38px;height:38px;padding:0;background:transparent;box-shadow:none}
.dock button img{display:block;width:40px;height:40px;max-width:none;object-fit:contain}
.dock button[aria-pressed=true]::after{content:'';position:absolute;bottom:-2px;width:3px;height:3px;border-radius:50%;background:#605247}
.dock .app-codex img{width:34px;height:34px;margin:3px;border-radius:8px;overflow:hidden}.screen .clock{color:#fff8eccc;background:linear-gradient(145deg,#fffdf5ee,#fff4de88 48%,#fffefaee);background-clip:text;-webkit-background-clip:text;-webkit-text-fill-color:transparent;text-shadow:0 1px 1px #fff5,0 3px 8px #8d48241a;font-weight:500}.screen .location{color:#fff8ead9;text-shadow:0 1px 3px #82462124}
.personal-laptop:focus-visible{outline:2px solid #ff522e;outline-offset:8px;border-radius:12px}.personal-laptop{cursor:pointer;width:100%;height:100%;position:relative;container-type:inline-size;perspective:1400px}
.scene{width:620px;height:380px;top:44%;left:50%;margin:0;transform:translateX(-50%) scale(calc(var(--laptop-width,320) / 620));transform-origin:top center}
.laptop{transform:rotateX(58deg) rotateZ(0deg)}.open .laptop{transform:rotateX(58deg) rotateZ(0)}
.laptop-open{position:absolute;bottom:0;left:50%;transform:translateX(-50%);border:1px solid #cbbdd7;background:#faf7ffeb;border-radius:20px;padding:6px 12px;white-space:nowrap;font-family:inherit;font-size:11px;line-height:1.2;color:#65566f;cursor:pointer}

/* Actual perpendicular chassis faces keep the shell dimensional through opening. */
.base{transform-style:preserve-3d;background:linear-gradient(145deg,#e3d7ed 0%,#c9b9da 32%,#baabce 74%,#d6c6e4);box-shadow:inset 0 2px 2px #fff9,inset 0 -2px 2px #88749880;border:1px solid #e8def2}
.base-bottom{position:absolute;inset:0;border-radius:18px;background:#796987;transform:translateZ(-9px)}
